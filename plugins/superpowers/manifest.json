        "category": "Superpowers"
      },
      {
        "command": "vibe-framework.superpowers.tdd",
        "title": "Superpowers: Enforce Test-Driven Development",
        "category": "Superpowers"
      },
      {
        "command": "vibe-framework.superpowers.debug",
        "title": "Superpowers: Systematic Debugging (4-Phase)",
        "category": "Superpowers"
      },
      {
        "command": "vibe-framework.superpowers.diagnose",
        "title": "Superpowers: Diagnose Session Behavior",
        "category": "Superpowers"
      }
