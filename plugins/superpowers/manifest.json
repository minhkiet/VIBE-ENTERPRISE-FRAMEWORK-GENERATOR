{
  "name": "vibe-framework-superpowers",
  "version": "7.0.2",
  "description": "Superpowers agentic software development methodology: Brainstorming, Planning, TDD, Systematic Debugging, and Multi-Agent Collaboration",
  "author": "Jesse Vincent / Vibe Enterprise Framework",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vibe-framework.superpowers.bootstrap",
    "onCommand:vibe-framework.superpowers.brainstorm",
